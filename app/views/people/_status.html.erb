<% active = status.to_s.strip.casecmp?("active") %>
<span class="inline-flex shrink-0 items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-medium <%= active ? "bg-emerald-50 text-emerald-700 ring-1 ring-emerald-200" : "bg-slate-100 text-slate-600 ring-1 ring-slate-200" %>">
  <span class="size-1.5 rounded-full <%= active ? "bg-emerald-500" : "bg-slate-400" %>"></span>
  <%= status.presence || "no status" %>
</span>
