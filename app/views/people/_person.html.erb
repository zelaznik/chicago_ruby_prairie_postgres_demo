<div id="<%= dom_id person %>" class="overflow-hidden rounded-lg bg-white shadow-sm ring-1 ring-slate-200">
  <div class="flex items-center gap-4 border-b border-slate-200 px-5 py-4">
    <span class="grid size-12 shrink-0 place-items-center rounded-full bg-sky-100 text-lg font-semibold text-sky-800">
      <%= person.username.to_s.first.to_s.upcase.presence || "?" %>
    </span>
    <h1 class="min-w-0 flex-1 truncate text-xl font-semibold"><%= person.username.presence || "Unnamed" %></h1>
    <%= render "people/status", status: person.status %>
  </div>

  <dl class="divide-y divide-slate-100 text-sm">
    <div class="grid grid-cols-3 gap-4 px-5 py-3">
      <dt class="text-slate-500">Username</dt>
      <dd class="col-span-2 text-slate-900"><%= person.username %></dd>
    </div>
    <div class="grid grid-cols-3 gap-4 px-5 py-3">
      <dt class="text-slate-500">Status</dt>
      <dd class="col-span-2 text-slate-900"><%= person.status %></dd>
    </div>
    <div class="grid grid-cols-3 gap-4 px-5 py-3">
      <dt class="text-slate-500">SSN</dt>
      <dd class="col-span-2 font-mono text-slate-900"><%= person.ssn.presence || "Not on file" %></dd>
    </div>
  </dl>
</div>
