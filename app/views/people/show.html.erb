<% content_for :title, @person.username.presence || "Person" %>

<%= link_to "‹ All people", people_path, class: "mb-4 inline-block text-sm text-slate-500 hover:text-slate-900" %>

<%= render @person %>

<div class="mt-6 flex items-center justify-between gap-3">
  <%= link_to "Edit", edit_person_path(@person), class: "btn btn-secondary" %>
  <%= button_to "Delete person", @person, method: :delete, class: "btn btn-danger",
        data: { turbo_confirm: "Delete #{@person.username.presence || 'this person'}?" } %>
</div>
